#!/usr/bin/env bash
# Runs tools/check.sh before a push, since GitHub Actions cannot run for this
# repository. Switch it on once per clone:
#   git config core.hooksPath .githooks
# Skip it for one push with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
check=false
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # deleting a branch or tag
    case "$local_ref" in refs/tags/*) continue ;; esac   # tags point at commits already checked
    commit=$(git rev-parse "$local_sha^{commit}")
    if [ "$commit" != "$head" ]; then
        echo "pre-push: $local_ref is not the checked-out commit, and the check builds the working tree." >&2
        echo "pre-push: check it out first, or push with --no-verify." >&2
        exit 1
    fi
    check=true
done
$check || exit 0

if ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard -- app fakegame)" ]; then
    echo "pre-push: there are changes not in the commit being pushed, so the check would not test that commit." >&2
    echo "pre-push: commit or stash them first, or push with --no-verify." >&2
    exit 1
fi

echo "pre-push: running tools/check.sh (tests, lint, both APKs)" >&2
tools/check.sh -q || {
    echo "pre-push: the check failed; nothing was pushed." >&2
    exit 1
}
