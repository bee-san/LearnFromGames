+// LearnFromGames: ClusterSort without its model and its sorting. Boxes and confidences are recomputed from the
+// symbols exactly as there, and every PARAGRAPH that has lines gets a BLOCK of its own, which the VisualAnnotation
+// conversion needs; but the paragraphs stay in the order detected and the lines of a paragraph in theirs. For a
+// caller that orders and groups the lines itself.
+static void BlockPerParagraph(PageLayout* l) {
+  ReorderUsingDfs(l);
+  {
+    const auto kids = ChildLists(*l);
+    const auto all = AllDescendants(*l, kids);
+    for (auto it = all.rbegin(); it != all.rend(); ++it) RobustBoxEstimation(l, *it, kids);
+  }
+  RecomputeConfidencesFromSymbols(l);
+  const auto kids = ChildLists(*l);
+  const size_t n = l->entities.size();
+  std::vector<bool> del(n, false);
+  for (size_t i = 0; i < n; i++) {
+    Entity& p = l->entities[i];
+    if (p.type == Type::kBlock) del[i] = true;
+    if (p.type != Type::kParagraph) continue;
+    if (kids[i].empty()) {
+      del[i] = true;
+      continue;
+    }
+    if (!p.orientation && !p.writing_direction && !p.textline_order) {
+      const Entity& c = l->entities[kids[i][0]];
+      p.orientation = c.orientation, p.writing_direction = c.writing_direction, p.textline_order = c.textline_order;
+    }
+    Entity blk;
+    blk.type = Type::kBlock;
+    blk.orientation = p.orientation, blk.writing_direction = p.writing_direction;
+    blk.textline_order = p.textline_order;
+    blk.box = p.box;
+    l->entities.push_back(std::move(blk));
+    l->entities[i].parent = static_cast<int>(l->entities.size()) - 1;
+  }
+  del.resize(l->entities.size(), false);
+  DeleteWithDescendants(l, del);
+  ReorderUsingDfs(l);
+  RecomputeConfidencesFromSymbols(l);
+}
