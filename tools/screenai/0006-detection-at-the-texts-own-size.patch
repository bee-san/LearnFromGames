 namespace screenai {
 
+
+#if defined(__linux__)
+// LearnFromGames: the cores that are not the slowest of the machine, by their top frequency; none where all cores
+// are alike or the frequencies cannot be read. A thread started for one invoke has no history for the scheduler to
+// go by and is put on a small core of a phone's processor, where the invoke takes three times as long: on a
+// Snapdragon 8 Gen 2 a screen's recognition took 54 ms left to the scheduler and 21 ms kept off its three small
+// cores.
+const cpu_set_t* FasterCores() {
+  static const cpu_set_t set = [] {
+    cpu_set_t s;
+    CPU_ZERO(&s);
+    long freq[CPU_SETSIZE], lowest = 0;
+    int n = 0;
+    for (; n < CPU_SETSIZE; n++) {
+      char path[96];
+      std::snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", n);
+      FILE* f = std::fopen(path, "r");
+      if (!f) break;
+      if (std::fscanf(f, "%ld", &freq[n]) != 1) freq[n] = 0;
+      std::fclose(f);
+      if (n == 0 || freq[n] < lowest) lowest = freq[n];
+    }
+    for (int i = 0; i < n; i++)
+      if (freq[i] > lowest) CPU_SET(i, &s);
+    return s;
+  }();
+  return CPU_COUNT(&set) > 0 ? &set : nullptr;
+}
+
+FasterCoresScope::FasterCoresScope() {
+  const cpu_set_t* faster = FasterCores();
+  if (!faster) return;
+  if (sched_getaffinity(0, sizeof before_, &before_) != 0) return;
+  set_ = sched_setaffinity(0, sizeof *faster, faster) == 0;
+}
+
+FasterCoresScope::~FasterCoresScope() {
+  if (set_) sched_setaffinity(0, sizeof before_, &before_);
+}
