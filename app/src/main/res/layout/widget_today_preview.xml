<?xml version="1.0" encoding="utf-8"?>
<!-- Today as the widget picker shows it, with made-up figures. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/today_rings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/widget_rings_preview" />

            <TextView
                android:id="@+id/today_title"
                style="@style/Widget.Lfg.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_title"
                android:visibility="gone" />

            <TextView
                android:id="@+id/today_streak"
                style="@style/Widget.Lfg.Streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:text="@string/widget_preview_streak" />
        </FrameLayout>

        <TextView
            android:id="@+id/today_time"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:text="@string/widget_preview_time"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/today_chars"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:text="@string/widget_preview_chars"
            android:textColor="@color/widget_ok" />
    </LinearLayout>
</FrameLayout>
