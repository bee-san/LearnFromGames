<?xml version="1.0" encoding="utf-8"?>
<!-- Today, square: the goal rings at the top left, the streak opposite, and today's figures in the rings' colours, cards only with their goal. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/today_rings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/today_title"
                style="@style/Widget.Lfg.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_label"
                android:visibility="gone" />

            <TextView
                android:id="@+id/today_streak"
                style="@style/Widget.Lfg.Streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end" />
        </FrameLayout>

        <TextView
            android:id="@+id/today_time"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <TextView
            android:id="@+id/today_chars"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <TextView
            android:id="@+id/today_cards"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:textColor="@color/widget_cards"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
