<?xml version="1.0" encoding="utf-8"?>
<!-- Last 7 days as the widget picker shows it, with made-up figures. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_title"
                style="@style/Widget.Lfg.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_week_label" />

            <TextView
                android:id="@+id/week_streak"
                style="@style/Widget.Lfg.Streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_streak" />
        </LinearLayout>

        <TextView
            android:id="@+id/week_total"
            style="@style/Widget.Lfg.Figure"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="30sp"
            android:text="3 h 41 min" />

        <TextView
            android:id="@+id/week_detail"
            style="@style/Widget.Lfg.Detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="21,434 characters · 5,753 an hour" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar0"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="640"
                        android:progressTint="@color/widget_ok" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar1"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="270"
                        android:progressTint="@color/widget_accent" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar2"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="0"
                        android:progressTint="@color/widget_accent" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar3"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="560"
                        android:progressTint="@color/widget_accent" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar4"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="430"
                        android:progressTint="@color/widget_accent" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar5"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="610"
                        android:progressTint="@color/widget_ok" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar6"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:progress="300"
                        android:progressTint="@color/widget_accent" />
                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/week_goal"
                style="@style/Widget.Lfg.Bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/widget_goal_line"
                android:progress="590" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/day0"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="T" />
            <TextView
                android:id="@+id/day1"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="F" />
            <TextView
                android:id="@+id/day2"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S" />
            <TextView
                android:id="@+id/day3"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S" />
            <TextView
                android:id="@+id/day4"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="M" />
            <TextView
                android:id="@+id/day5"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="T" />
            <TextView
                android:id="@+id/day6"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="W"
                android:textColor="@color/widget_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
