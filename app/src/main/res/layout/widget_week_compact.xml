<?xml version="1.0" encoding="utf-8"?>
<!-- Last 7 days, short: the week's total beside its name, then a bar a day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_title"
                style="@style/Widget.Lfg.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_week_label" />

            <TextView
                android:id="@+id/week_total"
                style="@style/Widget.Lfg.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar0"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar1"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar2"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar3"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar4"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar5"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar6"
                        style="@style/Widget.Lfg.Bar"
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/week_goal"
                style="@style/Widget.Lfg.Bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/widget_goal_line"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/day0"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day1"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day2"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day3"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day4"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day5"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/day6"
                style="@style/Widget.Lfg.Day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
